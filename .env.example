# Port Configurations
BACKEND_PORT=8989
POSTGRES_PORT=5443

# Database Credentials
POSTGRES_USER=dive_master
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=divelog_db

# Network Configurations
SERVER_ADDRESS=0.0.0.0

# Security Configurations
# Generate a secure 64-byte hex string for production tracking
JWT_SECRET=YOUR_HIGH_ENTROPY_JWT_SECRET_HERE

# Bootstrap admin account (created on first startup if not present)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

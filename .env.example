# =====================================================================
# Tauche environment configuration
# Copy to .env and edit:  cp .env.example .env
# Used by docker-compose.yml. Values here are EXAMPLES - change secrets.
# =====================================================================

# ---------------------------------------------------------------------
# Ports (HOST side)
# ---------------------------------------------------------------------
# The app's host port is fixed to 8989 in docker-compose.yml
# (container listens on 8080). Change it there if needed.
# Port Postgres is reachable on from your machine (container always uses 5432).
POSTGRES_PORT=5443

# ---------------------------------------------------------------------
# Database credentials (used by both Postgres and the app)
# ---------------------------------------------------------------------
POSTGRES_USER=dive_master
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=divelog_db

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# REQUIRED. Hex string, at least 64 hex chars (32 bytes). Generate with:
#   openssl rand -hex 32   (minimum)
#   openssl rand -hex 64   (recommended)
# The app will not start without this.
JWT_SECRET=REPLACE_WITH_HEX_SECRET_FROM_OPENSSL_RAND

# ---------------------------------------------------------------------
# Bootstrap admin account (created on first startup if not present)
# ---------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: promote an existing account to admin on startup.
PROMOTE_ADMIN_EMAIL=

# ---------------------------------------------------------------------
# CORS (only needed for split-host setups; same-origin is auto-allowed)
# ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:8989

# ---------------------------------------------------------------------
# Optional extras
# ---------------------------------------------------------------------
# Google Maps satellite tiles on the map page (frontend BUILD-TIME var).
# If unset, a free no-key satellite provider is used.
# Note: this is baked into the JS bundle; set before `npm run build`
# or pass as a Docker build arg - see DEPLOYMENT.md.
VITE_GOOGLE_MAPS_API_KEY=

# The app binds 0.0.0.0 automatically; no need to set SERVER_ADDRESS.
# SERVER_ADDRESS=0.0.0.0

# Spring Boot listen port inside the container (keep 8080 unless you
# also change the compose port mapping).
# PORT=8080
# BACKEND_PORT=8080
